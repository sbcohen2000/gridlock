{
    "name": "gridlock-web-client",
    "version": "1.0.0",
    "description": "A grid-based editor for plain text",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "build": "scripts/build.sh /",
        "watch": "esbuild src/app.ts --loader:.png=file --public-path=/dist --sourcemap=inline --bundle --outdir=www/dist --watch --servedir=www",
        "clean": "rm -rf www/dist",
        "typecheck": "tsc -p jsconfig.json",
        "playwright": "npx playwright test"
    },
    "author": "Sam Cohen",
    "license": "ISC",
    "devDependencies": {
        "esbuild": "^0.27.3",
        "gridlock-lib": "*"
    },
    "dependencies": {
        "@playwright/test": "^1.59.1"
    }
}

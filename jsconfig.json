{
    "compilerOptions": {
        "checkJs": true,
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*.js", "src/**/*.d.ts", "test/**/*.js"],
    "exclude": ["node_modules", "www"]
}
